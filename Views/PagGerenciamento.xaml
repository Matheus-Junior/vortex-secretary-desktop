<Window x:Class="vortex_secretary_desktop.Views.PagGerenciamento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:vortex_secretary_desktop"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="MainWindow"
        Height="727"
        Width="1060">
        <Grid>
            <Grid
                x:Name="mainGrid">
                <!--os grid de definição devem vir primeiro que os conteudos-->
                <Grid.RowDefinitions>
                    <!--cabeçalho-->
                    <RowDefinition 
                        Height="70"/>
                    <!--corpo-->
                    <RowDefinition 
                        Height="*"/>
                    <!--rodapé-->
                    <RowDefinition 
                        Height="auto"/>
                </Grid.RowDefinitions>

                <!--cabeçalho-->
                <Border
                    Background="#951711">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition 
                                Width="auto"/>
                            <ColumnDefinition 
                                Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button
                            Grid.Column="0"
                            Margin="10,5,0,0"
                            Padding="0"
                            ToolTip="Página Inicial"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="45"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0">
                            <Image
                                Source="Imagens\fatec_ra_metropolitana_sp_guarulhos_br.png"
                                Margin="5"/>
                        </Button> 
                            
                        <Grid
                            Grid.Column="1"
                            Margin="0,0,15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="*"/>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Label
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                                <Hyperlink
                                    PreviewMouseLeftButtonDown="AbrirRequerimentos"
                                    FontSize="16"
                                    Foreground="White"
                                    ToolTip="Inicio"
                                    Style="{StaticResource MaterialDesignOverlineHyperlink}"
                                    FontWeight="Bold">Inicio</Hyperlink>
                            </Label>
                            <Label
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                                <Hyperlink
                                    PreviewMouseLeftButtonDown="AbrirDuvidas"
                                    FontSize="16"
                                    ToolTip="Dúvidas"
                                    Foreground="White"
                                    Style="{StaticResource MaterialDesignOverlineHyperlink}"
                                    FontWeight="Bold">Dúvidas</Hyperlink>
                            </Label>
                            <Label
                                Grid.Column="3"
                                Margin="0,0,10,0"
                                IsEnabled="False"
                                VerticalAlignment="Center">
                                <Hyperlink
                                    FontSize="16"
                                    ToolTip="Gerenciamento"
                                    Foreground="White"
                                    Style="{StaticResource MaterialDesignOverlineHyperlink}"
                                    FontWeight="Bold">Gerenciamento</Hyperlink>
                            </Label>
                            <Label
                                Grid.Column="4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                                <Hyperlink
                                    PreviewMouseLeftButtonDown="AbrirHistorico"
                                    FontSize="16"
                                    ToolTip="Histórico"
                                    Foreground="White"
                                    Style="{StaticResource MaterialDesignOverlineHyperlink}"
                                    FontWeight="Bold">Histórico</Hyperlink>
                            </Label>
                            <Button
                                PreviewMouseLeftButtonDown="FecharPrograma"
                                Grid.Column="5"
                                Padding="0"
                                ToolTip="Sair"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="50"
                                Height="50"
                                Foreground="White"
                                materialDesign:ButtonAssist.CornerRadius="25"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0">
                                <materialDesign:PackIcon
                                    Kind="ExitToApp"
                                    Width="25"
                                    Height="25"
                                    Foreground="White"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                
                <Grid
                    Grid.Row="1"
                    Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!--corpo que tem scroll-->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Background="#951711"
                        Margin="250,80,250,150">
                        <ScrollViewer
                            Style="{StaticResource MaterialDesignScrollViewer}"
                            VerticalScrollBarVisibility="auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="auto"/>
                                    <RowDefinition
                                        Height="*"/>
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="20"
                                    Margin="10"
                                    HorizontalAlignment="Center"
                                    Content="Gerenciamento de Links"/>
                                <StackPanel
                                    Grid.Row="1"
                                    x:Name="formularioWrapPanel"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Stretch"
                                    Margin="150,20,150,30">
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            
            <!--area para exibir a nota extendida, ela sobrepõe toda a tela-->
            <ContentControl 
                x:Name="duvidaExtendidaContainer"
                Visibility="Collapsed"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="1"/>
        </Grid>
</Window>
