<UserControl x:Class="vortex_secretary_desktop.Views.Controls.RequerimentoNovoExtendido"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:vortex_secretary_desktop"
        mc:Ignorable="d"
        d:DesignHeight="520"
        d:DesignWidth="760">
        <!-- nota -->
        <Border
            Padding="5,5,5,15"
            Margin="10"
            Height="520"
            Width="760"
            Background="#951711"
            CornerRadius="10"
            BorderThickness="0.5"
            BorderBrush="White">

            <Grid 
                Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition 
                        Height="auto"/>
                    <RowDefinition 
                        Height="auto"/>
                    <RowDefinition 
                        Height="auto"/>
                    <RowDefinition 
                        Height="auto"/>
                    <RowDefinition 
                        Height="*"/>
                </Grid.RowDefinitions>
                
                <Border
                    Grid.Row="0"
                    Background="White"
                    BorderThickness="0"
                    BorderBrush="Black"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    CornerRadius="7">
                    <TextBlock 
                        Text="ERRADO!"
                        FontSize="13"
                        Foreground="Black"
                        Margin="9,3,9,3"/>
                </Border>

                <TextBlock 
                    Grid.Row="1"
                    Text="Requerimento"
                    FontWeight="Bold"
                    Foreground="White"
                    FontSize="28"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,20"/>

                <TextBlock
                    Grid.Row="2"
                    Text="Tipo"
                    Foreground="White"
                    FontWeight="Medium"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    TextWrapping="Wrap"/>
                
                <Border
                    Grid.Row="3"
                    Background="White"
                    CornerRadius="5"
                    Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition 
                                Height="auto"/>
                            <RowDefinition 
                                Height="auto"/>
                            <RowDefinition 
                                Height="auto"/>
                            <RowDefinition 
                                Height="auto"/>
                            <RowDefinition 
                                Height="auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid
                            Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Nome do solicitante:"
                                FontWeight="Medium"
                                FontSize="16"
                                Margin="0,0,10,20"/>
                            
                            <TextBlock
                                Grid.Column="1"
                                Text="_nome_"
                                FontWeight="Medium"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                TextWrapping="Wrap"/>
                        </Grid>
                        
                        <Grid
                            Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Curso:"
                                FontWeight="Medium"
                                FontSize="16"
                                Margin="0,0,10,20"/>
                            
                            <TextBlock
                                Grid.Column="1"
                                Text="_curso_"
                                FontWeight="Medium"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                TextWrapping="Wrap"/>
                        </Grid>
                        <Grid
                            Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Semestre:"
                                FontWeight="Medium"
                                FontSize="16"
                                Margin="0,0,10,20"/>
                            
                            <TextBlock
                                Grid.Column="1"
                                Text="_semestre_"
                                FontWeight="Medium"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                TextWrapping="Wrap"/>
                        </Grid>
                        <Grid
                            Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Documento:"
                                FontWeight="Medium"
                                FontSize="16"
                                Margin="0,0,10,20"/>
                            
                            <TextBlock
                                Grid.Column="1"
                                Text="_documento_"
                                FontWeight="Medium"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                TextWrapping="Wrap"/>
                        </Grid>
                        <Grid
                            Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition 
                                    Width="auto"/>
                                <ColumnDefinition 
                                    Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Avisos:"
                                FontWeight="Medium"
                                FontSize="16"
                                Margin="0,0,10,20"/>
                            
                            <TextBlock
                                Grid.Column="1"
                                Text="_avisos_"
                                FontWeight="Medium"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>
                
                <Grid
                    Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition 
                            Width="*"/>
                        <ColumnDefinition 
                            Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#992e2c"
                        Padding="10"
                        Height="40"
                        FontWeight="Bold"
                        Margin="0,0,20,0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="5">
                        Alterar Status
                    </Button>
                            
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="#992e2c"
                        Padding="10"
                        Height="40"
                        FontWeight="Bold"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="5">
                        Enviar documento
                    </Button>
                </Grid>
            </Grid>
        </Border>
</UserControl>
