<UserControl x:Class="vortex_secretary_desktop.Views.Controls.Template"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:vortex_secretary_desktop"
        mc:Ignorable="d"
        d:DesignHeight="300" 
        d:DesignWidth="400">
    <Border
        Padding="10"
        Height="300"
        Width="400"
        CornerRadius="10"
        BorderThickness="1"
        Background="#951711"
        BorderBrush="White">

        <Grid 
            Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition 
                    Height="*"/>
                <RowDefinition 
                    Height="*"/>
            </Grid.RowDefinitions>
            <materialDesign:PackIcon
                Grid.Row="0"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Kind="Cogs"
                Width="100"
                Height="70"
                Foreground="White"/>
            <Label
                Grid.Row="1"
                FontSize="30"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Foreground="White"
                FontWeight="Bold"
                Content="Em contrução..."/> 
            
        </Grid>
    </Border>
</UserControl>
