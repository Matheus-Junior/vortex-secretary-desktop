<UserControl x:Class="vortex_secretary_desktop.Views.Controls.DuvidaExtendida"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:vortex_secretary_desktop"
        mc:Ignorable="d"
        d:DesignHeight="520"
        d:DesignWidth="560">
        <!-- nota -->
        <Border
            Padding="5,5,5,15"
            Margin="10"
            Width="560"
            Height="520"
            Background="#951711"
            CornerRadius="10"
            BorderThickness="0.5"
            BorderBrush="White">

            <Grid 
                Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition 
                        Height="*"/>
                    <RowDefinition 
                        Height="*"/>
                    <RowDefinition 
                        Height="auto"/>
                </Grid.RowDefinitions>
                
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,30"
                    Background="White"
                    CornerRadius="5"
                    Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition 
                                Height="auto"/>
                            <RowDefinition 
                                Height="*"/>
                        </Grid.RowDefinitions>
                        
                        
                        <TextBlock
                            Grid.Row="0"
                            Text="_usuario_"
                            FontWeight="Medium"
                            FontSize="16"
                            Margin="0,0,10,10"/>
                        
                        <ScrollViewer
                            Grid.Row="1"
                            Style="{StaticResource MaterialDesignScrollViewer}"
                            VerticalScrollBarVisibility="auto">
                            <TextBlock
                                Grid.Row="0"
                                Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Mauris consectetur enim at interdum pulvinar. Cras lobortis porttitor augue at vehicula. Cras auctor nunc vitae metus porta maximus at at nisl. Donec ut nibh viverra, lobortis est eu, condimentum neque. Duis eget arcu ante. Suspendisse potenti. Vestibulum tempor mattis felis eu vehicula. Duis hendrerit finibus turpis id malesuada. Quisque congue porta orci, eget dictum augue eleifend nec.
Duis venenatis tristique neque, vitae molestie velit suscipit eu. Proin convallis urna quis lectus vestibulum, sit amet sagittis purus fermentum. Cras lobortis lacinia mauris a sodales. Praesent eget tristique erat, quis facilisis leo. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque imperdiet libero ac justo tincidunt tincidunt ac eu dui. Nullam consequat euismod urna malesuada volutpat. In vestibulum dolor feugiat, accumsan diam at, tincidunt est. Maecenas ac ipsum sit amet magna aliquet mollis vitae ac risus. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Praesent cursus nec diam dapibus placerat. Aliquam consectetur, nunc eget pretium ornare, diam nulla volutpat quam, fermentum pretium turpis turpis sit amet magna. Donec tellus urna, sodales tempor faucibus in, consectetur id ligula. Fusce eu metus a dui iaculis malesuada a sit amet mi. Lorem ipsum dolor sit amet, consectetur adipiscing elit."
                                FontSize="15"
                                TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Margin="0,0,0,30"
                    Background="White"
                    CornerRadius="5"
                    Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition 
                                Height="auto"/>
                            <RowDefinition 
                                Height="*"/>
                        </Grid.RowDefinitions>
                        
                        
                        <TextBlock
                            Grid.Row="0"
                            Text="_secretaria_"
                            FontWeight="Medium"
                            HorizontalAlignment="Right"
                            FontSize="16"
                            Margin="0,0,10,10"/>
                        
                        <ScrollViewer
                            Grid.Row="1"
                            Style="{StaticResource MaterialDesignScrollViewer}"
                            VerticalScrollBarVisibility="auto">
                            <TextBox
                                Grid.Row="0"
                                VerticalContentAlignment="Top"
                                HorizontalContentAlignment="Right"
                                materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                materialDesign:HintAssist.IsFloating="False"
                                BorderThickness="0"
                                materialDesign:HintAssist.Hint="Responder..."
                                FontSize="15"
                                TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                
                <Grid
                    Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition 
                            Width="*"/>
                        <ColumnDefinition 
                            Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#992e2c"
                        Padding="10"
                        Height="40"
                        FontWeight="Bold"
                        Margin="0,0,20,0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="10">
                        Enviar resposta
                    </Button>
                            
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="#992e2c"
                        Padding="10"
                        Height="40"
                        FontWeight="Bold"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="10">
                        Excluir dúvida e justificar
                    </Button>
                </Grid>
            </Grid>
        </Border>
</UserControl>
