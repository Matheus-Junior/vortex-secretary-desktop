<UserControl x:Class="vortex_secretary_desktop.Views.Controls.FormularioWeb"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:vortex_secretary_desktop"
        Background="Transparent"
        mc:Ignorable="d"
        Margin="0,0,0,20"
        d:DesignHeight="45"
        d:DesignWidth="850">
        
        <Grid 
            Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition 
                    Width="*"/>
                <ColumnDefinition 
                    Width="auto"/>
                <ColumnDefinition 
                    Width="auto"/>
            </Grid.ColumnDefinitions>
            
            <Border
                Grid.Column="0"
                Background="#992e2c"
                Margin="0,0,120,0">
                <TextBlock
                    TextAlignment="Center"
                    VerticalAlignment="Center">
                    <Hyperlink
                        FontWeight="Bold"
                        FontSize="17"
                        Foreground="White"
                        NavigateUri="https://www.fatecguarulhos.edu.br/"
                        Style="{StaticResource MaterialDesignOverlineHyperlink}">https://www.fatecguarulhos.edu.br/
                    </Hyperlink>
                </TextBlock>
            </Border>
            
            <Grid
                Grid.Column="1"
                HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition 
                        Width="*"/>
                    <ColumnDefinition 
                        Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton
                    Grid.Column="0"
                    Foreground="White"
                    Content="Ativo"
                    FontSize="17"
                    Margin="15,0,30,0"
                    Style="{StaticResource MaterialDesignRadioButton}"
                    materialDesign:RadioButtonAssist.RadioButtonSize="20"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    FontWeight="Bold"/>
                <RadioButton
                    Grid.Column="1"
                    Content="Inativo"
                    Foreground="White"
                    FontSize="17"
                    Style="{StaticResource MaterialDesignRadioButton}"
                    materialDesign:RadioButtonAssist.RadioButtonSize="20"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    FontWeight="Bold"/>
            </Grid>
            
        </Grid>
</UserControl>
